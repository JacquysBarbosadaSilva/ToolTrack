{
    "name": "tooltrack-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "tsx src/server.ts",
        "tables:create": "tsx src/scripts/create-tables.ts",
        "seed": "tsx src/scripts/seed.ts",
        "simulate": "tsx src/scripts/simulate.ts",
        "aws:check": "tsx -e \"import('./src/config/aws').then(m=>m.assertAwsConnection()).then(()=>console.log('AWS OK'))\""
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.600.0",
        "@aws-sdk/lib-dynamodb": "^3.600.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "pdfkit": "^0.20.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^20.14.0",
        "@types/pdfkit": "^0.17.6",
        "tsx": "^4.16.0",
        "typescript": "^5.5.0"
    }
}
